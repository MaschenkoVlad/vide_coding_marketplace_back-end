# Server
PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
# For Docker: postgresql://vibe_user:vibe_password_mk@localhost:5432/vibe_marketplace?schema=public
DATABASE_URL="postgresql://vibe_user:vibe_password_mk@localhost:5432/vibe_marketplace?schema=public"

# Redis (for caching, sessions, queues)
# For Docker: redis://localhost:6379
REDIS_URL="redis://localhost:6379"

# CORS (comma-separated origins)
CORS_ORIGIN="http://localhost:3000,http://localhost:4000"

# API Documentation
API_TITLE="Marketplace API"
API_DESCRIPTION="REST API for marketplace application"
API_VERSION="0.0.1"
