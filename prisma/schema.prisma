// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// Enums
// ============================================

enum UserRole {
  BUYER
  SELLER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum ListingCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  POOR
}

enum ListingStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  SOLD
  BLOCKED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CANCELED
  FAILED
  EXPIRED
}

enum Currency {
  USD
  UAH
}

// ============================================
// Core Models
// ============================================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String   // hashed password
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  role      UserRole @default(BUYER)
  status    UserStatus @default(PENDING_VERIFICATION)
  
  // Profile fields
  avatar    String?
  phone     String?
  bio       String?
  
  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  // Relations
  refreshTokenSessions RefreshTokenSession[]
  listings Listing[]
  orders Order[]
  
  @@index([email])
  @@index([status])
  @@index([role])
  @@map("users")
}

model RefreshTokenSession {
  id           String   @id @default(uuid())
  tokenFamily  String   @map("token_family") // for rotation tracking
  hashedToken  String   @map("hashed_token")   // hashed refresh token
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  revokedAt    DateTime? @map("revoked_at")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  
  // Relations
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([tokenFamily])
  @@index([hashedToken])
  @@index([expiresAt])
  @@map("refresh_token_sessions")
}

// ============================================
// Category Model
// ============================================

model Category {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  
  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  
  // Relations
  listings Listing[]
  
  @@index([slug])
  @@map("categories")
}

// ============================================
// Listing Model
// ============================================

model Listing {
  id          String          @id @default(uuid())
  sellerId    String          @map("seller_id")
  categoryId  String          @map("category_id")
  title       String
  description String
  price       Int             // stored in cents
  currency    Currency
  condition   ListingCondition
  city        String?
  attributes  Json            // flexible attributes for category-specific fields
  status      ListingStatus   @default(DRAFT)
  
  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  // Relations
  seller   User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])
  orders Order[]
  
  // Indexes for performance
  @@index([status, createdAt])
  @@index([categoryId, status])
  @@index([price])
  @@index([sellerId, status])
  @@map("listings")
}

// ============================================
// Order Model (for Stripe Checkout)
// ============================================

model Order {
  id          String      @id @default(uuid())
  buyerId     String      @map("buyer_id")
  listingId   String      @map("listing_id")
  amount      Int         // stored in cents (matches Listing price format)
  currency    Currency
  status      OrderStatus @default(PENDING_PAYMENT)

  // Stripe fields
  stripeCheckoutSessionId String  @unique @map("stripe_checkout_session_id")
  stripePaymentIntentId String? @map("stripe_payment_intent_id")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  buyer   User    @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  paymentEvents PaymentEvent[]

  // Indexes
  @@index([buyerId, status])
  @@index([listingId])
  @@index([stripeCheckoutSessionId])
  @@index([status, createdAt])
  @@map("orders")
}

// ============================================
// PaymentEvent Model (for webhook idempotency)
// ============================================

model PaymentEvent {
  id            String   @id @default(uuid())
  stripeEventId String   @unique @map("stripe_event_id")
  type          String   // e.g., "checkout.session.completed"
  processedAt   DateTime @default(now()) @map("processed_at")
  orderId       String?  @map("order_id")

  // Relations
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  // Indexes
  @@index([stripeEventId])
  @@index([type])
  @@index([processedAt])
  @@map("payment_events")
}
